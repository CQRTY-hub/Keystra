# Copy this file to .env.local and fill in real values there.
# .env.local is gitignored. Never commit real secrets.

# --- Database (Supabase Postgres, via Prisma) ---
# DATABASE_URL: the pooled connection (Supavisor), port 6543 — what the
# running app uses. Copy this from Supabase's "Connect" dialog, "ORMs" tab.
DATABASE_URL="postgresql://user:password@localhost:6543/postgres?pgbouncer=true"
# DIRECT_URL: the direct connection, port 5432 — only used by Prisma CLI
# commands (migrate, studio), never by the running app.
DIRECT_URL="postgresql://user:password@localhost:5432/postgres"

# --- Fulfillment provider selector ---
# "mock" (default, this phase) or "codeswholesale" (Phase 3, not implemented yet)
FULFILLMENT_PROVIDER="mock"

# --- CodesWholesale (Phase 3 — building against the sandbox) ---
# Two separate hosts, per PLAN.md Phase 0.5 — never mix them up:
#   Sandbox (build and test against this):  https://sandbox.codeswholesale.com
#   Live (real orders, later in Phase 3):   https://api.codeswholesale.com
# CODESWHOLESALE_API_BASE below is set to sandbox on purpose — that's what
# we build against until the shop is actually ready to take real payments.
# Client ID/secret: your own sandbox pair from app.codeswholesale.com (API
# tab) — or, to start, the shared public demo pair CodesWholesale publishes
# in their own docs' Authorization example, meant for exactly this.
CODESWHOLESALE_CLIENT_ID=""
CODESWHOLESALE_CLIENT_SECRET=""
CODESWHOLESALE_API_BASE="https://sandbox.codeswholesale.com"

# --- Mollie (stubbed this phase) ---
MOLLIE_API_KEY=""
MOLLIE_WEBHOOK_SECRET=""

# --- Email provider selector ---
# "mock" (default, this phase) or "resend" / "postmark" (Phase 3.6, not implemented yet)
EMAIL_PROVIDER="mock"
EMAIL_FROM="orders@example.com"

# --- Key encryption (Phase 3.8) ---
# Application-level encryption key for DeliveredKey.value at rest. Not used yet.
KEY_ENCRYPTION_SECRET=""

# --- Sentry (not wired yet) ---
SENTRY_DSN=""

# --- Admin panel (Phase 3.5) ---
# The one email allowed to log in — there is no registration route, no
# roles, no user management (PLAN.md, "Access"). This only decides which
# address scripts/admin-setup.ts creates the AdminCredential row for; the
# password and 2FA secret themselves live in the database, never here.
ADMIN_EMAIL=""

# --- App ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
