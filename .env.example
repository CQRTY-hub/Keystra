# Copy this file to .env.local and fill in real values there.
# .env.local is gitignored. Never commit real secrets.

# --- Database (Supabase Postgres, via Prisma) ---
DATABASE_URL="postgresql://user:password@localhost:5432/storefront?schema=public"

# --- Fulfillment provider selector ---
# "mock" (default, this phase) or "codeswholesale" (Phase 3, not implemented yet)
FULFILLMENT_PROVIDER="mock"

# --- CodesWholesale (sandbox only until Phase 3) ---
CODESWHOLESALE_CLIENT_ID=""
CODESWHOLESALE_CLIENT_SECRET=""
CODESWHOLESALE_API_BASE="https://sandbox.codeswholesale.com"

# --- Mollie (stubbed this phase) ---
MOLLIE_API_KEY=""
MOLLIE_WEBHOOK_SECRET=""

# --- Email provider selector ---
# "mock" (default, this phase) or "resend" / "postmark" (Phase 3.6, not implemented yet)
EMAIL_PROVIDER="mock"
EMAIL_FROM="orders@example.com"

# --- Key encryption (Phase 3.8) ---
# Application-level encryption key for DeliveredKey.value at rest. Not used yet.
KEY_ENCRYPTION_SECRET=""

# --- Sentry (not wired yet) ---
SENTRY_DSN=""

# --- App ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
